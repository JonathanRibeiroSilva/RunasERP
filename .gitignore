# Graphify (per-file AST cache is regenerable and bloats the repo; graph outputs are tracked)
graphify-out/cache/
# Dated snapshots: a full ~7MB copy of graph.json per run, and git history already
# keeps every previous version of it. Nothing reads them — manifest.json does not
# reference any dated directory. The current graph at graphify-out/ stays tracked.
graphify-out/20*/

