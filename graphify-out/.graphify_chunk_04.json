{
  "nodes": [
    {
      "id": "microservices_architecture",
      "type": "architecture_pattern",
      "label": "Microservices Architecture",
      "properties": {
        "description": "Sistema distribuído com serviços independentes",
        "isolation": "Database per Service pattern"
      }
    },
    {
      "id": "api_gateway",
      "type": "service",
      "label": "API Gateway",
      "properties": {
        "port": "8000",
        "url": "http://localhost:8000",
        "status": "70%",
        "responsibilities": ["Autenticação JWT", "Rate Limiting", "Roteamento", "Middleware de logging"]
      }
    },
    {
      "id": "clientes_service",
      "type": "service",
      "label": "Serviço Clientes",
      "properties": {
        "port": "8001",
        "url": "http://clientes:8001",
        "status": "5%",
        "responsibilities": ["Gestão de clientes", "Endereços", "Controle de crédito", "Histórico"]
      }
    },
    {
      "id": "produtos_service",
      "type": "service",
      "label": "Serviço Produtos",
      "properties": {
        "port": "8002",
        "url": "http://produtos:8002",
        "status": "5%",
        "responsibilities": ["Catálogo", "Variantes", "Fornecedores", "CRUD de produtos", "Categorias"]
      }
    },
    {
      "id": "estoque_service",
      "type": "service",
      "label": "Serviço Estoque",
      "properties": {
        "port": "8003",
        "url": "http://estoque:8003",
        "status": "5%",
        "responsibilities": ["Controle de estoque", "Movimentações", "Lotes", "Alertas", "Inventário"]
      }
    },
    {
      "id": "vendas_service",
      "type": "service",
      "label": "Serviço Vendas",
      "properties": {
        "port": "8004",
        "url": "http://vendas:8004",
        "status": "5%",
        "responsibilities": ["Carrinho", "Pedidos", "Pagamentos", "Checkout", "Frete"]
      }
    },
    {
      "id": "financeiro_service",
      "type": "service",
      "label": "Serviço Financeiro",
      "properties": {
        "port": "8005",
        "url": "http://financeiro:8005",
        "status": "5%",
        "responsibilities": ["Contas a receber", "Vendas fiadas", "Pagamentos", "Cobranças", "Relatórios"]
      }
    },
    {
      "id": "notificacoes_service",
      "type": "service",
      "label": "Serviço Notificações",
      "properties": {
        "port": "8006",
        "url": "http://notificacoes:8006",
        "status": "5%",
        "responsibilities": ["WhatsApp via Evolution API", "Eventos", "Histórico"]
      }
    },
    {
      "id": "postgresql",
      "type": "infrastructure",
      "label": "PostgreSQL",
      "properties": {
        "port": "5432",
        "version": "15",
        "databases": 8,
        "strategy": "Database per Service"
      }
    },
    {
      "id": "rabbitmq",
      "type": "infrastructure",
      "label": "RabbitMQ",
      "properties": {
        "port": "5672",
        "purpose": "Mensageria assíncrona entre serviços"
      }
    },
    {
      "id": "redis",
      "type": "infrastructure",
      "label": "Redis",
      "properties": {
        "port": "6379",
        "uses": ["Cache", "Sessões", "Rate limiting", "Carrinho de compras (TTL 2h)", "Blacklist de tokens"]
      }
    },
    {
      "id": "pgadmin",
      "type": "infrastructure",
      "label": "pgAdmin",
      "properties": {
        "port": "5050",
        "purpose": "Interface de administração de bancos"
      }
    },
    {
      "id": "evolution_api",
      "type": "infrastructure",
      "label": "Evolution API",
      "properties": {
        "port": "8080",
        "purpose": "Integração com WhatsApp"
      }
    },
    {
      "id": "jwt_auth",
      "type": "security_mechanism",
      "label": "JWT Authentication",
      "properties": {
        "description": "JSON Web Tokens para autenticação stateless",
        "features": ["Refresh Tokens", "Blacklist no Redis", "Expiração configurável"]
      }
    },
    {
      "id": "oauth2",
      "type": "security_mechanism",
      "label": "OAuth2",
      "properties": {
        "providers": ["Google", "Microsoft"],
        "status": "deprecated_for_operators",
        "current_use": "apenas clientes compradores"
      }
    },
    {
      "id": "rbac",
      "type": "security_mechanism",
      "label": "Role-Based Access Control",
      "properties": {
        "roles": ["ADMIN", "GERENTE", "VENDEDOR", "OPERADOR", "CLIENTE"],
        "implementation": "Middlewares de autorização no API Gateway"
      }
    },
    {
      "id": "rate_limiting",
      "type": "security_mechanism",
      "label": "Rate Limiting",
      "properties": {
        "anonymous": "100 req/min por IP",
        "authenticated": "500 req/min por usuário"
      }
    },
    {
      "id": "sync_communication",
      "type": "communication_pattern",
      "label": "Comunicação Síncrona HTTP",
      "properties": {
        "protocol": "HTTP/REST",
        "use_cases": ["Frontend ↔ API Gateway", "API Gateway ↔ Microserviços", "Microserviços ↔ Microserviços"],
        "library": "httpx async"
      }
    },
    {
      "id": "async_communication",
      "type": "communication_pattern",
      "label": "Comunicação Assíncrona RabbitMQ",
      "properties": {
        "protocol": "AMQP",
        "use_cases": ["Eventos de domínio", "Notificações", "Processamento em background"]
      }
    },
    {
      "id": "db_gateway",
      "type": "database",
      "label": "db_gateway",
      "properties": {
        "owner": "API Gateway",
        "stores": ["usuários", "tokens", "clientes_auth"]
      }
    },
    {
      "id": "db_clientes",
      "type": "database",
      "label": "db_clientes",
      "properties": {
        "owner": "Serviço de Clientes",
        "stores": ["clientes", "endereços", "crédito"]
      }
    },
    {
      "id": "db_produtos",
      "type": "database",
      "label": "db_produtos",
      "properties": {
        "owner": "Serviço de Produtos",
        "stores": ["produtos", "variantes", "categorias", "fornecedores"]
      }
    },
    {
      "id": "db_estoque",
      "type": "database",
      "label": "db_estoque",
      "properties": {
        "owner": "Serviço de Estoque",
        "stores": ["estoque", "movimentações", "lotes"]
      }
    },
    {
      "id": "db_vendas",
      "type": "database",
      "label": "db_vendas",
      "properties": {
        "owner": "Serviço de Vendas",
        "stores": ["pedidos", "itens_pedido", "carrinhos"]
      }
    },
    {
      "id": "db_financeiro",
      "type": "database",
      "label": "db_financeiro",
      "properties": {
        "owner": "Serviço Financeiro",
        "stores": ["contas_receber", "pagamentos"]
      }
    },
    {
      "id": "db_notificacoes",
      "type": "database",
      "label": "db_notificacoes",
      "properties": {
        "owner": "Serviço de Notificações",
        "stores": ["notificacoes", "historico"]
      }
    },
    {
      "id": "db_evolution",
      "type": "database",
      "label": "db_evolution",
      "properties": {
        "owner": "Evolution API",
        "stores": ["configurações WhatsApp"]
      }
    },
    {
      "id": "usuario_model",
      "type": "data_model",
      "label": "Usuario (Operadores)",
      "properties": {
        "table": "gateway.usuarios",
        "fields": ["id", "email", "senha_hash", "nome", "role", "empresa_id"],
        "auth_types": ["email/senha"]
      }
    },
    {
      "id": "cliente_auth_model",
      "type": "data_model",
      "label": "ClienteAuth (Clientes Compradores)",
      "properties": {
        "table": "gateway.clientes_auth",
        "fields": ["id", "email", "senha_hash", "cliente_id", "empresa_id"],
        "auth_types": ["email/senha", "OAuth Google", "OAuth Microsoft"]
      }
    },
    {
      "id": "layered_architecture",
      "type": "architecture_pattern",
      "label": "Arquitetura em Camadas",
      "properties": {
        "layers": ["Router (FastAPI)", "Service Layer", "Repository Layer", "Database"],
        "description": "Separação de responsabilidades em camadas"
      }
    },
    {
      "id": "router_layer",
      "type": "architecture_layer",
      "label": "Router Layer",
      "properties": {
        "responsibilities": ["Endpoints HTTP", "Validação de entrada", "Tratamento de exceções HTTP"]
      }
    },
    {
      "id": "service_layer",
      "type": "architecture_layer",
      "label": "Service Layer",
      "properties": {
        "responsibilities": ["Lógica de negócio", "Validações de domínio", "Gerenciamento de transações", "Orquestração de operações"]
      }
    },
    {
      "id": "repository_layer",
      "type": "architecture_layer",
      "label": "Repository Layer",
      "properties": {
        "responsibilities": ["Operações CRUD", "Queries SQL", "Mapeamento ORM"]
      }
    },
    {
      "id": "fastapi",
      "type": "technology",
      "label": "FastAPI",
      "properties": {
        "purpose": "Framework web assíncrono",
        "language": "Python"
      }
    },
    {
      "id": "sqlalchemy",
      "type": "technology",
      "label": "SQLAlchemy",
      "properties": {
        "version": "2.0",
        "purpose": "ORM com suporte async"
      }
    },
    {
      "id": "pydantic",
      "type": "technology",
      "label": "Pydantic",
      "properties": {
        "purpose": "Validação de dados e schemas"
      }
    },
    {
      "id": "alembic",
      "type": "technology",
      "label": "Alembic",
      "properties": {
        "purpose": "Migrations de banco de dados"
      }
    },
    {
      "id": "docker",
      "type": "technology",
      "label": "Docker",
      "properties": {
        "purpose": "Containerização"
      }
    },
    {
      "id": "nginx",
      "type": "technology",
      "label": "Nginx",
      "properties": {
        "purpose": "Reverse proxy para produção"
      }
    },
    {
      "id": "structlog",
      "type": "technology",
      "label": "Structlog",
      "properties": {
        "purpose": "Logging estruturado"
      }
    },
    {
      "id": "httpx",
      "type": "technology",
      "label": "httpx",
      "properties": {
        "purpose": "Cliente HTTP assíncrono para comunicação entre serviços"
      }
    },
    {
      "id": "pika",
      "type": "technology",
      "label": "Pika",
      "properties": {
        "purpose": "Cliente Python para RabbitMQ"
      }
    }
