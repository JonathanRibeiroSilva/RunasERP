# Template do ambiente de DESENVOLVIMENTO: docker-compose.dev.yml e erp.ps1 up.
# Copie para .env na raiz. O compose so le o .env da raiz para interpolar ${VAR};
# nenhum container recebe este arquivo inteiro, so o que o compose repassa.
# O CI valida este arquivo: docker compose --env-file .env.example -f docker-compose.dev.yml config

# JWT
# Declarada em api-gateway/config.py e services/vendas/config.py; o compose
# repassa aos 8 containers. Vazia = o compose usa dev-secret-key-change-in-production.
SECRET_KEY=troque-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RabbitMQ (container rabbitmq)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# Mercado Pago (Sandbox)
# Em runtime as credenciais MP sao por lojista, gravadas no banco
# (vendas.configuracoes_pagamento). Estas tres so sao lidas pelo script
# services/vendas/scripts/set_mercadopago_credentials.py, que as copia para o
# banco (sem argumento: empresa_id=4). O compose repassa ao container vendas.
MP_ACCESS_TOKEN=TEST-SEU_TOKEN
MP_WEBHOOK_SECRET=SEU_SEGREDO
MP_PUBLIC_KEY=TEST-SUA_CHAVE
# "production" liga o checkout real; qualquer outro valor = sandbox (services/vendas/config.py).
MP_ENVIRONMENT=sandbox

# Evolution API (WhatsApp) -- o container evolution-api so sobe com --profile whatsapp.
# REPASSADA pelo compose ao notificacoes, mas nenhum codigo do notificacoes a le
# (verificado em 2026-09-28). O vendas le EVOLUTION_API_URL (outro nome),
# EVOLUTION_API_KEY e EVOLUTION_INSTANCE, mas o compose nao repassa nenhuma ao vendas.
EVOLUTION_URL=http://evolution-api:8080
# Vira AUTHENTICATION_API_KEY do container evolution-api (vazia = change-me).
# Tambem repassada ao notificacoes, que nao a le.
EVOLUTION_API_KEY=SUA_CHAVE
# REPASSADA pelo compose ao notificacoes, mas nenhum codigo do notificacoes a le
# (verificado em 2026-09-28).
EVOLUTION_INSTANCE=runas
# SERVER_URL do container evolution-api (docker-compose.dev.yml:160).
EVOLUTION_SERVER_URL=http://localhost:8080

# Telefone responsável (alertas internos) - formato E.164
# NAO LIDA POR NENHUM CODIGO (verificado em 2026-09-28): candidata a remocao
TELEFONE_RESPONSAVEL=+5511999999999

# PostgreSQL - Database único com schemas separados
# Um único container PostgreSQL com 9 schemas (gateway, empresas, clientes, produtos,
# estoque, vendas, financeiro, notificacoes, evolution), criados por postgres/init-schemas.sql.
# O search_path é fixado no database.py de cada serviço.
# Nao troque o usuario/banco "erp": o healthcheck do db, a URI do evolution-api e os
# GRANT do init-schemas.sql estao fixos em erp.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
DATABASE_URL_GATEWAY=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_EMPRESAS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_CLIENTES=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_PRODUTOS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_ESTOQUE=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_VENDAS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_FINANCEIRO=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_NOTIFICACOES=postgresql+asyncpg://erp:erp@db:5432/erp

# URLs internas entre serviços. O compose repassa todas ao api-gateway e so
# CLIENTES/PRODUTOS/ESTOQUE/FINANCEIRO ao vendas (o vendas tambem le EMPRESAS_URL,
# mas fica no default http://empresas:8007).
EMPRESAS_URL=http://empresas:8007
CLIENTES_URL=http://clientes:8001
PRODUTOS_URL=http://produtos:8002
ESTOQUE_URL=http://estoque:8003
VENDAS_URL=http://vendas:8004
FINANCEIRO_URL=http://financeiro:8005
NOTIFICACOES_URL=http://notificacoes:8006

# pgAdmin
# NAO LIDA POR NENHUM CODIGO (verificado em 2026-09-28): candidata a remocao
# (o servico pgadmin esta comentado no docker-compose.dev.yml)
PGADMIN_EMAIL=admin@runas.local
PGADMIN_PASSWORD=troque-me

# Celery
# NAO LIDA POR NENHUM CODIGO (verificado em 2026-09-28): candidata a remocao
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
# NAO LIDA POR NENHUM CODIGO (verificado em 2026-09-28): candidata a remocao
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Admin padrão (seed, api-gateway/seed.py)
ADMIN_EMAIL=admin@runas.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrador

# Email SMTP (Gmail) -- o compose repassa so ao api-gateway.
# Crie uma conta Gmail dedicada para o sistema (ex: noreply.suaempresa@gmail.com)
# Ative verificação em duas etapas e gere um App Password em:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.suaempresa@gmail.com
SMTP_PASSWORD=troque-me
SMTP_FROM_NAME=Runas ERP
# Local dev. Tunel (docker-compose.cloudflare.yml) e producao: https://app.runaserp.com.br
FRONTEND_URL=http://localhost:3000

# Frontend (local dev — Vite proxy encaminha /api para api-gateway:8000)
VITE_API_URL=/api
# Lida em frontend/src/config/env.ts, mas nenhum componente usa env.oauth: o login
# OAuth monta o redirect como <origem>/auth/callback/google|microsoft.
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# SEM EFEITO NESTE ARQUIVO (verificado em 2026-09-28): candidata a remocao deste template.
# frontend/vite.config.ts le process.env.VITE_USE_PROXY (so "false" desliga o proxy),
# mas docker-compose.dev.yml:555 fixa "true" no container; o valor daqui nunca chega la.
VITE_USE_PROXY=true
# Rotulo do host do painel da plataforma (frontend/src/config/host.ts, default
# "admin"): host cujo primeiro rotulo e este monta o painel; os demais, o ERP.
# Em dev as duas aplicacoes convivem em localhost; admin.localhost:3000 exercita
# a separacao de producao. So mude se o subdominio do painel mudar.
# VITE_HOST_PLATAFORMA=admin

# URL pública da API (Mercado Pago webhooks e back_urls). Tunel e producao: https://app.runaserp.com.br/api
API_BASE_URL=http://localhost:8000

# OAuth Google
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Veja documentação completa em: docs/02-desenvolvimento/OAUTH_PROVIDERS_CONFIG.md
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-me

# OAuth Microsoft Azure
# Obtenha em: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Veja documentação completa em: docs/02-desenvolvimento/OAUTH_PROVIDERS_CONFIG.md
MICROSOFT_CLIENT_ID=SEU_CLIENT_ID
MICROSOFT_CLIENT_SECRET=troque-me
MICROSOFT_TENANT_ID=common

# Frontend OAuth (VITE) — mesmos client IDs acima.
# Lidas em frontend/src/config/env.ts, mas nenhum componente usa env.oauth: o
# fluxo OAuth pede a URL de autorizacao ao gateway (/auth/cliente/oauth/*/init).
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=SEU_CLIENT_ID
VITE_MICROSOFT_TENANT_ID=common

# ==================== PLATAFORMA (SUPER_ADMIN) ====================
# Sem EMAIL e PASSWORD o super admin nao e criado no seed.
SUPER_ADMIN_EMAIL=plataforma@runas.com
SUPER_ADMIN_PASSWORD=Plataforma@123
SUPER_ADMIN_NAME=Plataforma

# ==================== INTEGRACOES POR TENANT ====================
# Cifra as credenciais (Evolution/SMTP/Mercado Pago) gravadas por cada lojista.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia = o servico de vendas RECUSA gravar integracao (nunca grava texto plano).
# Trocar esta chave torna as credenciais ja gravadas irrecuperaveis.
INTEGRACOES_SECRET_KEY=

# ==================== COBRANCA DA PLATAFORMA ====================
# Conta Mercado Pago do DONO da plataforma (cobra a mensalidade dos lojistas).
# Nada a ver com as credenciais MP de cada lojista, que ficam em vendas.
PLATAFORMA_MP_ACCESS_TOKEN=
# Protege POST /plataforma/jobs/regua, chamado pelo cron do host.
# Vazio = a rota recusa toda chamada.
# Sugestao de cron diario:
#   0 3 * * * curl -fsS -X POST -H "X-Job-Token: SEU_TOKEN" http://localhost:8000/plataforma/jobs/regua
PLATAFORMA_JOB_TOKEN=

# Segredo compartilhado entre vendas e api-gateway. Protege
# POST /auth/cliente/registrar-interno, que aceita a senha ja hasheada: quem
# chama define a senha da conta do comprador. O MESMO valor nos dois servicos.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio em qualquer um dos lados = fail-open: o gateway loga
# cliente.internal_register.sem_segredo e aceita (so barra quem traz X-Forwarded-For).
REGISTRO_INTERNO_TOKEN=

# Prova de origem interna entre os 8 containers (INFRA-C).
# MESMO valor no api-gateway e nos 7 servicos. Vazio = fail-open:
# o validador loga servico_interno.ausente e deixa passar.
# Gerar com: openssl rand -hex 32
SERVICO_INTERNO_TOKEN=

# Prova de que o X-Plataforma saiu do router /plataforma do gateway (G1b).
# MESMO valor SO no api-gateway e no empresas -- escopo menor que o
# SERVICO_INTERNO_TOKEN de proposito. Vazio = fail-open.
# Gerar com: openssl rand -hex 32
PLATAFORMA_INTERNO_TOKEN=

# Lidas pelo codigo mas NAO repassadas pelo docker-compose.dev.yml: defini-las
# aqui nao tem efeito. Para usar, acrescente-as ao environment do servico no compose.
#   api-gateway: SMTP_FROM_EMAIL, IDEMPOTENCY_TTL_SECONDS (padrao 86400),
#                DOCS_ENABLED (padrao false), ADMIN_EMPRESA_ID (seed, padrao 1)
#   vendas:      EVOLUTION_API_URL, EVOLUTION_API_KEY, EVOLUTION_INSTANCE,
#                API_GATEWAY_URL (padrao http://api-gateway:8000),
#                EMPRESAS_URL (padrao http://empresas:8007), SMTP_*
