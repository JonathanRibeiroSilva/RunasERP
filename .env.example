# JWT
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# Mercado Pago (Sandbox)
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_WEBHOOK_SECRET=your-webhook-secret-here
MP_PUBLIC_KEY=TEST-your-public-key-here
MP_ENVIRONMENT=sandbox

# Evolution API (WhatsApp)
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_INSTANCE=runas

# Telefone responsável (alertas internos) - formato E.164
TELEFONE_RESPONSAVEL=+5511999999999

# PostgreSQL - Database único com schemas separados
# Um único container PostgreSQL com 8 schemas (gateway, clientes, produtos, estoque, vendas, financeiro, notificacoes, evolution)
# O search_path é configurado automaticamente no database.py de cada serviço
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
DATABASE_URL_GATEWAY=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_EMPRESAS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_CLIENTES=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_PRODUTOS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_ESTOQUE=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_VENDAS=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_FINANCEIRO=postgresql+asyncpg://erp:erp@db:5432/erp
DATABASE_URL_NOTIFICACOES=postgresql+asyncpg://erp:erp@db:5432/erp

# URLs internas entre serviços
CLIENTES_URL=http://clientes:8001
PRODUTOS_URL=http://produtos:8002
ESTOQUE_URL=http://estoque:8003
VENDAS_URL=http://vendas:8004
FINANCEIRO_URL=http://financeiro:8005
NOTIFICACOES_URL=http://notificacoes:8006

# pgAdmin
PGADMIN_EMAIL=admin@runas.local
PGADMIN_PASSWORD=admin123

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Admin padrão (seed)
ADMIN_EMAIL=admin@runas.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrador

# Email SMTP (Gmail)
# Crie uma conta Gmail dedicada para o sistema (ex: noreply.suaempresa@gmail.com)
# Ative verificação em duas etapas e gere um App Password em:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.suaempresa@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Runas ERP
# Local dev. Produção/tunnel: https://runaserp.com.br
FRONTEND_URL=http://localhost:3000

# Frontend (local dev — Vite proxy encaminha /api para api-gateway:8000)
VITE_API_URL=/api
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_USE_PROXY=true

# URL pública da API (Mercado Pago webhooks). Produção: https://runaserp.com.br/api
API_BASE_URL=http://localhost:8000

# OAuth Google
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Veja documentação completa em: docs/02-desenvolvimento/OAUTH_PROVIDERS_CONFIG.md
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Microsoft Azure
# Obtenha em: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Veja documentação completa em: docs/02-desenvolvimento/OAUTH_PROVIDERS_CONFIG.md
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# Frontend OAuth (VITE) — mesmos client IDs acima
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# ==================== PLATAFORMA (SUPER_ADMIN) ====================
# Sem estas duas variaveis o super admin nao e criado no seed.
SUPER_ADMIN_EMAIL=plataforma@runas.com
SUPER_ADMIN_PASSWORD=Plataforma@123
SUPER_ADMIN_NAME=Plataforma

# ==================== INTEGRACOES POR TENANT ====================
# Cifra as credenciais (Evolution/SMTP/Mercado Pago) gravadas por cada lojista.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia = o servico de vendas RECUSA gravar integracao (nunca grava texto plano).
# Trocar esta chave torna as credenciais ja gravadas irrecuperaveis.
INTEGRACOES_SECRET_KEY=

# ==================== COBRANCA DA PLATAFORMA ====================
# Conta Mercado Pago do DONO da plataforma (cobra a mensalidade dos lojistas).
# Nada a ver com as credenciais MP de cada lojista, que ficam em vendas.
PLATAFORMA_MP_ACCESS_TOKEN=
# Protege POST /plataforma/jobs/regua, chamado pelo cron do host.
# Sugestao de cron diario:
#   0 3 * * * curl -fsS -X POST -H "X-Job-Token: SEU_TOKEN" http://localhost:8000/plataforma/jobs/regua
PLATAFORMA_JOB_TOKEN=
