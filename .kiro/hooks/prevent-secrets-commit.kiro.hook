{
  "enabled": true,
  "name": "Prevent Secrets in Commits",
  "description": "Previne commit de chaves de API e credenciais sensíveis (Mercado Pago, Stripe, AWS, etc). Bloqueia o commit se detectar padrões suspeitos em arquivos staged.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "\n# Verificar se há padrões sensíveis em arquivos staged\ngit diff --cached --name-only --diff-filter=ACM | while read file; do\n    if [ -f \"$file\" ] && file \"$file\" | grep -q \"text\"; then\n        # Verificar padrões sensíveis\n        if grep -Eq \"APP_USR-[0-9]{13}-[0-9]{6}-[a-f0-9]{32}-[0-9]{10}|sk_test_|sk_live_|AKIA[0-9A-Z]{16}\" \"$file\"; then\n            echo \"❌ ERRO: Chave sensível detectada em $file\"\n            exit 1\n        fi\n    fi\ndone\necho \"✅ Nenhum segredo detectado\"\n"
  },
  "workspaceFolderName": "RunasERP",
  "shortName": "prevent-secrets-commit"
}