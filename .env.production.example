# ============================================
# EXEMPLO DE CONFIGURAÇÃO PARA PRODUÇÃO
# ============================================
# Copie este arquivo para .env e ajuste os valores
# para usar o domínio runaserp.com.br
# ============================================

# ============================================
# DOMÍNIO E URLs DE PRODUÇÃO
# ============================================
FRONTEND_URL=https://runaserp.com.br
API_BASE_URL=https://runaserp.com.br/api

# ============================================
# SEGURANÇA (ALTERAR EM PRODUÇÃO!)
# ============================================
SECRET_KEY=GERAR_CHAVE_SEGURA_AQUI  # Use: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# BANCO DE DADOS
# ============================================
POSTGRES_USER=erp
POSTGRES_PASSWORD=SENHA_FORTE_AQUI  # Alterar!
POSTGRES_DB=erp

# URLs de conexão (NÃO ALTERAR - usar os schemas separados)
DATABASE_URL_GATEWAY=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=gateway
DATABASE_URL_EMPRESAS=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=empresas
DATABASE_URL_CLIENTES=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=clientes
DATABASE_URL_PRODUTOS=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=produtos
DATABASE_URL_ESTOQUE=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=estoque
DATABASE_URL_VENDAS=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=vendas
DATABASE_URL_FINANCEIRO=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=financeiro
DATABASE_URL_NOTIFICACOES=postgresql://erp:SENHA_FORTE_AQUI@db:5432/erp?options=-c%20search_path=notificacoes

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_DEFAULT_USER=erp_user
RABBITMQ_DEFAULT_PASS=SENHA_RABBITMQ_AQUI  # Alterar!
RABBITMQ_URL=amqp://erp_user:SENHA_RABBITMQ_AQUI@rabbitmq:5672/

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=amqp://erp_user:SENHA_RABBITMQ_AQUI@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================
# USUÁRIO ADMINISTRADOR INICIAL
# ============================================
ADMIN_EMAIL=admin@runaserp.com.br
ADMIN_PASSWORD=Admin@Prod2026  # Alterar após primeiro login!
ADMIN_NAME=Administrador

# ============================================
# OAUTH2 - GOOGLE
# ============================================
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# Redirect URI configurado no Google Console:
# https://runaserp.com.br/auth/callback

# ============================================
# OAUTH2 - MICROSOFT
# ============================================
MICROSOFT_CLIENT_ID=seu-microsoft-client-id
MICROSOFT_CLIENT_SECRET=seu-microsoft-client-secret
MICROSOFT_TENANT_ID=common
VITE_MICROSOFT_CLIENT_ID=seu-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# Redirect URI configurado no Azure:
# https://runaserp.com.br/auth/callback

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-gmail  # Gerar em: https://myaccount.google.com/apppasswords
SMTP_FROM_NAME=Runas ERP

# ============================================
# MERCADO PAGO (PRODUÇÃO!)
# ============================================
MP_ACCESS_TOKEN=APP_USR-seu-access-token-producao
MP_PUBLIC_KEY=APP_USR-sua-public-key-producao
MP_ENVIRONMENT=production
# Assina/valida os webhooks recebidos — sem isso qualquer POST forja um pagamento
MP_WEBHOOK_SECRET=SEGREDO_DO_WEBHOOK_AQUI

# ============================================
# CLOUDFLARE TUNNEL
# ============================================
# Zero Trust > Networks > Tunnels > (seu tunnel) > token de instalação
CLOUDFLARE_TUNNEL_TOKEN=TOKEN_DO_TUNNEL_AQUI

# Webhook configurado no Mercado Pago:
# https://runaserp.com.br/api/vendas/webhook/mercadopago

# ============================================
# EVOLUTION API (WhatsApp)
# ============================================
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-api-aqui
EVOLUTION_INSTANCE=runas

# ============================================
# PGADMIN
# ============================================
PGADMIN_EMAIL=admin@runaserp.com.br
PGADMIN_PASSWORD=pgadmin_senha_segura  # Alterar!

# ============================================
# URLS DOS MICROSSERVIÇOS (PRODUÇÃO)
# ============================================
EMPRESAS_URL=http://empresas-prod:8007
CLIENTES_URL=http://clientes-prod:8001
PRODUTOS_URL=http://produtos-prod:8002
ESTOQUE_URL=http://estoque-prod:8003
VENDAS_URL=http://vendas-prod:8004
FINANCEIRO_URL=http://financeiro-prod:8005
NOTIFICACOES_URL=http://notificacoes-prod:8006
API_GATEWAY_URL=http://api-gateway-prod:8000

# ============================================
# OBSERVAÇÕES IMPORTANTES
# ============================================
# 
# 1. SEGURANÇA:
#    - Altere TODAS as senhas e chaves secretas
#    - Use senhas fortes (mínimo 16 caracteres)
#    - Nunca commite o arquivo .env no git
#
# 2. OAUTH2:
#    - Configure os Redirect URIs nos consoles:
#      * Google: https://console.cloud.google.com/apis/credentials
#      * Microsoft: https://portal.azure.com
#    - Use: https://runaserp.com.br/auth/callback
#
# 3. MERCADO PAGO:
#    - Use credenciais de PRODUÇÃO
#    - Configure webhook: https://runaserp.com.br/api/vendas/webhook/mercadopago
#    - Teste pagamentos em modo produção
#
# 4. SMTP:
#    - Para Gmail, ative autenticação de 2 fatores
#    - Gere senha de app em: https://myaccount.google.com/apppasswords
#
# 5. BACKUP:
#    - Configure backup automático do banco de dados
#    - Mantenha backups em local seguro
#
# 6. MONITORING:
#    - Configure UptimeRobot ou similar
#    - Monitore: https://runaserp.com.br/api/health
#
# 7. SSL:
#    - Certificados Let's Encrypt expiram a cada 90 dias
#    - Configure renovação automática
#
# ============================================
