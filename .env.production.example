# ============================================
# EXEMPLO DE CONFIGURAÇÃO PARA PRODUÇÃO
# ============================================
# Modelo das variáveis que o docker-compose.prod.yml interpola. Em produção elas
# vivem em DOIS lugares:
#   1. Coolify (Environment Variables da aplicação): fonte da verdade de tudo que
#      os containers leem em runtime.
#   2. Secret PROD_ENV do GitHub: o .github/workflows/deploy.yml grava o conteúdo
#      dele como .env no runner, só para o build. Precisa ter pelo menos as
#      variáveis com ${VAR:?} no compose (senão o compose nem faz parse) e as
#      VITE_*, que são embutidas no bundle do frontend na hora do build.
# Só chega a um container a variável que o compose repassa no `environment:`
# daquele serviço — definir aqui algo que o compose não repassa não tem efeito.
# O deploy.yml também usa os secrets COOLIFY_TOKEN, COOLIFY_URL e COOLIFY_UUID,
# e o uptime.yml usa TELEGRAM_BOT_TOKEN e TELEGRAM_CHAT_ID: esses são secrets do
# GitHub, não entram neste arquivo.
# ============================================

# ============================================
# IMAGENS (docker-compose.prod.yml só faz pull)
# ============================================
# Ambos têm default no compose — só defina para publicar em outro namespace
# ou fixar um rollback num commit específico (o CI publica :<sha> e :latest).
# REGISTRY=ghcr.io/jonathanribeirosilva/runaserp
# TAG=latest

# ============================================
# DOMÍNIO E URLs DE PRODUÇÃO
# ============================================
# O app fica no subdomínio (tunnel). runaserp.com.br é a landing no Cloudflare
# Pages, fora do tunnel — apontar FRONTEND_URL para lá quebra o login: o gateway
# usa FRONTEND_URL no CORS, nos cookies (https), no link de reset de senha e no
# back_url da assinatura; o vendas (também recebe) usa nos cookies da loja e nas
# URLs de retorno do Mercado Pago. O build do frontend deriva dela o
# VITE_OAUTH_REDIRECT_URI, mas nenhum código usa esse valor (o redirect OAuth sai
# de window.location.origin). Obrigatória no compose (${FRONTEND_URL:?}).
FRONTEND_URL=https://app.runaserp.com.br
# O painel da plataforma (admin.runaserp.com.br) é o mesmo container e o mesmo
# bundle; quem separa é o hostname lido em frontend/src/config/host.ts. Chama a
# /api relativa (same-origin), então NÃO entra no CORS: FRONTEND_URL continua o app.
# VITE_HOST_PLATAFORMA (rótulo do host do painel, default "admin") não precisa
# ser definida: frontend/Dockerfile não declara ARG, então nenhum VITE_* de build
# arg chega ao bundle e vale o default. Mudar o rótulo exige declarar o ARG lá,
# passá-lo em docker-compose.build.yml e trocar o ^admin\. de frontend/nginx.conf.
# Lida pelo vendas: monta a notification_url do Mercado Pago
# ({API_BASE_URL}/loja/{slug}/webhook/mercadopago). Obrigatória no compose.
API_BASE_URL=https://app.runaserp.com.br/api

# ============================================
# SEGURANÇA (ALTERAR EM PRODUÇÃO!)
# ============================================
# Obrigatória no compose; vai para os 8 containers pela âncora x-service-env
# (todo serviço valida o JWT emitido pelo gateway).
# Gere com: openssl rand -hex 32
SECRET_KEY=troque-me
# Repassadas ao api-gateway e ao vendas (defaults do compose: HS256 / 30).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Só o api-gateway lê (default 7).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# BANCO DE DADOS
# ============================================
# Usadas pelo container db, pelo erp-db-backup-prod (pg_dump a cada deploy, em
# /data/erp/backups no host) e pelo erp-db-init-prod. USER e PASSWORD são
# obrigatórias no compose; POSTGRES_DB tem default "erp".
POSTGRES_USER=erp
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=erp

# Uma por container, repassada como DATABASE_URL. Todas obrigatórias no compose.
# Driver asyncpg obrigatório: todo serviço abre a conexão com create_async_engine,
# e `postgresql://` puro derruba o processo no boot ("asyncio extension requires
# an async driver"). Sem search_path na URL — asyncpg não aceita `options`, e cada
# database.py já injeta o schema do serviço via connect_args/server_settings.
# Usuário e senha têm de bater com POSTGRES_USER / POSTGRES_PASSWORD.
DATABASE_URL_GATEWAY=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_EMPRESAS=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_CLIENTES=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_PRODUTOS=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_ESTOQUE=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_VENDAS=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_FINANCEIRO=postgresql+asyncpg://erp:troque-me@db:5432/erp
DATABASE_URL_NOTIFICACOES=postgresql+asyncpg://erp:troque-me@db:5432/erp

# ============================================
# REDIS
# ============================================
# Vai para os 8 containers via x-service-env. Default no compose: este mesmo valor.
REDIS_URL=redis://redis:6379/0

# ============================================
# RABBITMQ
# ============================================
# Credenciais do container rabbitmq. Obrigatórias no compose.
RABBITMQ_DEFAULT_USER=erp_user
RABBITMQ_DEFAULT_PASS=troque-me
# Vai para os 8 containers via x-service-env. Obrigatória no compose; usuário e
# senha têm de bater com as duas de cima.
RABBITMQ_URL=amqp://erp_user:troque-me@rabbitmq:5672/

# ============================================
# CELERY
# ============================================
# NAO LIDA POR NENHUM CODIGO (verificado em 2026-09-28): candidata a remocao
# Nenhum compose, serviço, workflow ou script lê estas duas; o job diário é cron
# do host batendo num endpoint (ver PLATAFORMA_JOB_TOKEN), não Celery.
CELERY_BROKER_URL=amqp://erp_user:troque-me@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================
# USUÁRIO ADMINISTRADOR INICIAL
# ============================================
# Lidas pelo api-gateway/seed.py. EMAIL e PASSWORD são obrigatórias no compose.
# A senha é cortada em 72 bytes (limite do bcrypt). Troque após o primeiro login.
ADMIN_EMAIL=admin@runaserp.com.br
ADMIN_PASSWORD=troque-me
ADMIN_NAME=Administrador

# ============================================
# OAUTH2 - GOOGLE
# ============================================
# GOOGLE_* vão para o api-gateway (runtime): é ele que monta a URL de autorização
# com GOOGLE_CLIENT_ID. VITE_GOOGLE_CLIENT_ID é build arg do frontend
# (docker-compose.build.yml, via secret PROD_ENV); o frontend/src/config/env.ts a
# lê, mas nenhum código usa env.oauth hoje — sem efeito prático.
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-me
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# Redirect URI a registrar no Google Console (o frontend monta com
# window.location.origin):
# https://app.runaserp.com.br/auth/callback/google

# ============================================
# OAUTH2 - MICROSOFT
# ============================================
# MICROSOFT_* vão para o api-gateway (runtime; TENANT_ID default "common").
# VITE_MICROSOFT_* são build args do frontend (secret PROD_ENV); como a
# VITE_GOOGLE_CLIENT_ID, são lidas em env.ts e não usadas por nenhum código.
MICROSOFT_CLIENT_ID=seu-microsoft-client-id
MICROSOFT_CLIENT_SECRET=troque-me
MICROSOFT_TENANT_ID=common
VITE_MICROSOFT_CLIENT_ID=seu-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# Redirect URI a registrar no Azure:
# https://app.runaserp.com.br/auth/callback/microsoft

# ============================================
# EMAIL (SMTP)
# ============================================
# Em produção o compose só repassa SMTP_* ao api-gateway (reset de senha etc.).
# O vendas também declara SMTP_* no config.py, mas o compose não repassa: lá
# ficam os defaults (usuário vazio). Defaults do compose: smtp.gmail.com / 587 /
# "Runas ERP".
# O remetente é "SMTP_FROM_NAME <SMTP_USER>". SMTP_FROM_EMAIL existe no
# api-gateway/config.py, mas nenhum código a usa e o compose não a repassa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
# Senha de app do Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=troque-me
SMTP_FROM_NAME=Runas ERP

# ============================================
# MERCADO PAGO (LOJISTAS)
# ============================================
# As credenciais MP usadas em runtime são POR EMPRESA, gravadas (cifradas) em
# vendas.configuracoes_pagamento pela tela de integração — incluindo o segredo
# de assinatura do webhook, que o vendas lê do banco, não daqui.
# MP_ACCESS_TOKEN, MP_PUBLIC_KEY e MP_WEBHOOK_SECRET são repassadas ao vendas,
# mas só services/vendas/scripts/set_mercadopago_credentials.py as lê — e esse
# script aborta quando MP_ENVIRONMENT=production. Em produção ficam sem uso.
MP_ACCESS_TOKEN=SEU_TOKEN
MP_PUBLIC_KEY=SUA_PUBLIC_KEY
MP_WEBHOOK_SECRET=troque-me
# Lida pelo vendas: "production" liga o checkout real; qualquer outro valor usa
# sandbox. Default no código é "sandbox"; no compose de produção, "production".
MP_ENVIRONMENT=production

# Nada a configurar no painel do MP para os lojistas: o webhook é por empresa e
# vai como notification_url em cada preference —
# {API_BASE_URL}/loja/{slug}/webhook/mercadopago

# ============================================
# CLOUDFLARE TUNNEL
# ============================================
# Obrigatória no compose (container cloudflared, modo token).
# Zero Trust > Networks > Tunnels > (seu tunnel) > token de instalação
CLOUDFLARE_TUNNEL_TOKEN=SEU_TOKEN

# ============================================
# EVOLUTION API (WhatsApp)
# ============================================
# A CONFIRMAR: o compose de produção repassa estas três ao notificacoes-prod,
# mas o config.py do notificacoes não declara nenhuma delas (são ignoradas). Quem
# lê Evolution é o vendas, com outro nome — EVOLUTION_API_URL, EVOLUTION_API_KEY
# e EVOLUTION_INSTANCE — e o compose de produção não repassa essas ao vendas.
# O container evolution-api também não sobe em produção. Hoje, sem efeito.
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-me
EVOLUTION_INSTANCE=runas

# ============================================
# URLS DOS MICROSSERVIÇOS (PRODUÇÃO)
# ============================================
# Todas têm default no compose igual ao valor abaixo; só defina para mudar.
# O gateway recebe as 7 dos serviços; o vendas recebe EMPRESAS, CLIENTES,
# PRODUTOS, ESTOQUE, FINANCEIRO e API_GATEWAY_URL (não VENDAS_URL); o estoque
# recebe PRODUTOS_URL. Nenhum outro container recebe URL de serviço.
EMPRESAS_URL=http://empresas-prod:8007
CLIENTES_URL=http://clientes-prod:8001
PRODUTOS_URL=http://produtos-prod:8002
ESTOQUE_URL=http://estoque-prod:8003
VENDAS_URL=http://vendas-prod:8004
FINANCEIRO_URL=http://financeiro-prod:8005
NOTIFICACOES_URL=http://notificacoes-prod:8006
API_GATEWAY_URL=http://api-gateway-prod:8000

# ============================================
# OBSERVAÇÕES IMPORTANTES
# ============================================
#
# 1. SEGURANÇA:
#    - Altere TODAS as senhas e chaves secretas
#    - Use senhas fortes (mínimo 16 caracteres)
#    - Nunca commite o arquivo .env no git
#
# 2. OAUTH2:
#    - Configure os Redirect URIs nos consoles:
#      * Google: https://console.cloud.google.com/apis/credentials
#      * Microsoft: https://portal.azure.com
#    - Use: https://app.runaserp.com.br/auth/callback/google e
#      https://app.runaserp.com.br/auth/callback/microsoft
#
# 3. MERCADO PAGO:
#    - Credenciais dos lojistas: pela tela de integração de cada empresa
#    - Webhook é por empresa, enviado em cada preference — nada a cadastrar no painel
#
# 4. SMTP:
#    - Para Gmail, ative autenticação de 2 fatores
#    - Gere senha de app em: https://myaccount.google.com/apppasswords
#
# 5. BACKUP:
#    - O container erp-db-backup-prod faz pg_dump a cada deploy, antes das
#      migrations, em /data/erp/backups no host (guarda os 14 mais recentes).
#    - Mesmo disco do banco: não cobre perda da VPS. Cópia off-site ainda falta.
#
# 6. MONITORING:
#    - .github/workflows/uptime.yml sonda https://app.runaserp.com.br/api/health/ready
#      (banco, Redis e os 7 serviços) e avisa no Telegram.
#
# 7. SSL:
#    - Nada a fazer: TLS termina na Cloudflare e o tráfego chega pelo tunnel.
#      Não há nginx nem Let's Encrypt nesta stack.
#
# ============================================

# ==================== PLATAFORMA (SUPER_ADMIN) ====================
# Lidas pelo api-gateway/seed.py. Sem EMAIL e PASSWORD o super admin nao e
# criado no seed. SUPER_ADMIN_NAME tem default "Plataforma".
SUPER_ADMIN_EMAIL=plataforma@runas.com
SUPER_ADMIN_PASSWORD=troque-me
SUPER_ADMIN_NAME=Plataforma

# ==================== INTEGRACOES POR TENANT ====================
# Lida pelo vendas (e pela migration 20260828_110000_integracao).
# Cifra as credenciais (Evolution/SMTP/Mercado Pago) gravadas por cada lojista.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia = o servico de vendas RECUSA gravar integracao (nunca grava texto plano).
# Trocar esta chave torna as credenciais ja gravadas irrecuperaveis.
INTEGRACOES_SECRET_KEY=

# ==================== COBRANCA DA PLATAFORMA ====================
# Lida pelo api-gateway. Conta Mercado Pago do DONO da plataforma (cobra a
# mensalidade dos lojistas). Nada a ver com as credenciais MP de cada lojista,
# que ficam em vendas. Vazia = criar assinatura falha.
PLATAFORMA_MP_ACCESS_TOKEN=
# Lida pelo api-gateway. Protege POST /plataforma/jobs/regua, chamado pelo cron
# do host. Vazia = a rota responde 403 para todo mundo (a regua nao roda).
# Nao ha porta publicada no host em producao (e a 8000 do host e o Coolify), entao
# o cron entra no container. Sugestao de cron diario:
#   0 3 * * * docker exec erp-api-gateway-prod curl -fsS -X POST -H "X-Job-Token: SEU_TOKEN" http://localhost:8000/plataforma/jobs/regua
PLATAFORMA_JOB_TOKEN=

# Segredo compartilhado entre vendas e api-gateway. Protege
# POST /auth/cliente/registrar-interno, que aceita a senha ja hasheada: quem
# chama define a senha da conta do comprador. O MESMO valor nos dois servicos.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio = fail-open: o gateway loga cliente.internal_register.sem_segredo e
# deixa passar; so a recusa de requisicao com X-Forwarded-For barra o que vem
# de fora.
REGISTRO_INTERNO_TOKEN=

# Prova de origem interna entre os 8 containers (INFRA-C).
# MESMO valor no api-gateway e nos 7 servicos. O gateway so carimba; quem valida
# sao os 7 servicos. Vazio = fail-closed: o validador loga servico_interno.ausente
# e responde 403 (so /health passa).
# Gerar com: openssl rand -hex 32
SERVICO_INTERNO_TOKEN=

# Prova de que o X-Plataforma saiu do router /plataforma do gateway (G1b).
# MESMO valor SO no api-gateway e no empresas -- escopo menor que o
# SERVICO_INTERNO_TOKEN de proposito. Vazio = fail-open.
# Gerar com: openssl rand -hex 32
PLATAFORMA_INTERNO_TOKEN=
