# ngrok Configuration
# Obtenha seu token em: https://dashboard.ngrok.com/get-started/your-authtoken

# Seu token de autenticação do ngrok
# Deixe em branco para usar ngrok sem autenticação (com limitações)
NGROK_AUTHTOKEN=your_token_here

# Região do ngrok (opcional)
# Opções: us, eu, au, ap, sa, jp, in
# Padrão: us
NGROK_REGION=us
