# API Configuration for Ngrok
# URL do Ngrok: https://pretty-dissuade-brunette.ngrok-free.dev
VITE_API_URL=https://pretty-dissuade-brunette.ngrok-free.dev/api

# Application
VITE_APP_NAME=ERP Runas
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_ANALYTICS=true

# Token Configuration
VITE_TOKEN_REFRESH_THRESHOLD=300000

# OAuth Configuration
