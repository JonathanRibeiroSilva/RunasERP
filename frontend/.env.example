# =============================================================================
# FRONTEND - VARIÁVEIS DE AMBIENTE
# =============================================================================
#
# ⚠️  ATENÇÃO: Quando rodando via Docker, estas variáveis NÃO são lidas.
#     As variáveis vêm da seção `environment:` do docker-compose.dev.yml
#
#     Este arquivo serve para:
#     1. Documentação das variáveis disponíveis
#     2. Desenvolvimento local SEM Docker (npm run dev direto)
#
# Para desenvolvimento local sem Docker:
#   cp .env.example .env.local
#   npm run dev
#
# Para Docker (desenvolvimento):
#   As variáveis são definidas em docker-compose.dev.yml
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Docker + Cloudflare: usar /api (URL relativa — Cloudflare faz proxy)
# Local sem Docker: usar http://localhost:8000 (direto no backend)
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# Habilitar proxy do Vite (apenas para local sem Docker)
# false = Cloudflare faz o proxy (Docker)
# true  = Vite faz o proxy (local sem Docker)
VITE_USE_PROXY=true

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
VITE_APP_NAME=Runas ERP
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Features
# -----------------------------------------------------------------------------
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Token
# -----------------------------------------------------------------------------
VITE_TOKEN_REFRESH_THRESHOLD=300000

# -----------------------------------------------------------------------------
# OAuth
# -----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
