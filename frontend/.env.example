# =============================================================================
# FRONTEND - VARIÁVEIS DE AMBIENTE (template)
# =============================================================================
#
# Este arquivo nunca é lido: é documentação. Para rodar sem Docker:
#   cp .env.example .env.local      (frontend/.gitignore ignora .env.local)
#   npm run dev
#
# Dois mecanismos diferentes leem variáveis, e isso importa:
#
# 1. O código do app (import.meta.env.VITE_*) recebe as variáveis dos arquivos
#    .env* e do ambiente do processo. Quando a mesma variável existe nos dois, a
#    do ambiente vence (regra do Vite). No Docker, o frontend-dev recebe as do
#    bloco environment: do docker-compose.dev.yml, que portanto prevalecem.
#
# 2. O vite.config.ts lê process.env direto, sem loadEnv: VITE_USE_PROXY e
#    VITE_API_GATEWAY_TARGET só funcionam se estiverem no ambiente do shell ou do
#    container. Escrever essas duas no .env.local não tem efeito.
#
# Em produção nenhum VITE_* de build arg chega ao bundle: frontend/Dockerfile
# não declara ARG, então valem os defaults de src/config/env.ts e host.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# API (lidas pelo app, src/config/env.ts)
# -----------------------------------------------------------------------------
# /api (padrão): URL relativa. No dev com Docker o próprio Vite faz proxy de /api
# para o api-gateway; em produção quem faz é o nginx da imagem (frontend/nginx.conf).
# Sem Docker, dá para apontar direto para o gateway: http://localhost:8000
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Proxy do dev server (lidas pelo vite.config.ts via process.env, NÃO por este arquivo)
# -----------------------------------------------------------------------------
# Qualquer valor diferente de "false" liga o proxy de /api (vite.config.ts:79).
# O docker-compose.dev.yml fixa VITE_USE_PROXY="true".
# VITE_API_GATEWAY_TARGET é o destino do proxy (padrão http://api-gateway:8000,
# que só resolve dentro da rede do Docker). Sem Docker, exporte no shell:
#   VITE_API_GATEWAY_TARGET=http://localhost:8000 npm run dev
VITE_USE_PROXY=true
# VITE_API_GATEWAY_TARGET=http://localhost:8000

# -----------------------------------------------------------------------------
# Separação por host (lida por src/config/host.ts)
# -----------------------------------------------------------------------------
# Primeiro label do hostname que monta o painel da plataforma em vez do ERP.
# Padrão: admin (admin.runaserp.com.br em produção). Em dev as duas aplicações
# convivem em localhost; admin.localhost:3000 exercita o caminho de produção.
# VITE_HOST_PLATAFORMA=admin

# -----------------------------------------------------------------------------
# Features
# -----------------------------------------------------------------------------
# Lida por um único ponto do código (env.enableDevtools).
VITE_ENABLE_DEVTOOLS=true
# SEM EFEITO: env.ts lê, mas nenhum código usa env.enableAnalytics
# (verificado em 2026-09-28). Candidata a remoção.
VITE_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# SEM EFEITO: env.ts lê, mas nenhum código usa env.appName nem env.appVersion
# (verificado em 2026-09-28). Candidatas a remoção.
VITE_APP_NAME=Runas ERP
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Token
# -----------------------------------------------------------------------------
# SEM EFEITO: env.ts lê, mas nenhum código usa env.tokenRefreshThreshold. O
# frontend não renova o token: ao receber 401, services/api/axios.ts desloga, e
# nada chama POST /auth/refresh (verificado em 2026-09-28). Candidata a remoção.
VITE_TOKEN_REFRESH_THRESHOLD=300000

# -----------------------------------------------------------------------------
# OAuth
# -----------------------------------------------------------------------------
# SEM EFEITO: env.ts lê as quatro em env.oauth, mas nenhum código usa env.oauth
# (verificado em 2026-09-28). O login social existe só para o cliente da loja
# online, e o fluxo passa pelo backend (/auth/cliente/oauth/*), que guarda os
# client IDs e secrets. O redirect_uri real é montado no navegador:
#   <window.location.origin>/auth/callback/google
#   <window.location.origin>/auth/callback/microsoft
# O docker-compose.dev.yml ainda repassa essas quatro ao frontend-dev.
# Candidatas a remoção.
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID
VITE_MICROSOFT_CLIENT_ID=SEU_CLIENT_ID
VITE_MICROSOFT_TENANT_ID=common
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback/google
