# Dockerfile para desenvolvimento com hot reload
# Node 22 com melhor suporte a módulos nativos

FROM node:22-alpine

WORKDIR /app

# Instalar dependências de build necessárias para módulos nativos
RUN apk add --no-cache python3 make g++ curl

# Copiar package files
COPY package*.json ./

# Forçar limpeza e reinstalação completa
RUN rm -rf node_modules && \
    npm cache clean --force && \
    npm install --verbose

# Copiar código fonte
COPY . .

# Expor porta do Vite
EXPOSE 3000

# Variáveis fixas de watch (não dependem do ambiente)
# Polling necessário para watch funcionar no Docker
# Intervalo de 1000ms (1s) reduz falsos positivos no Windows/Docker
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=1000
# VITE_HMR_HOST, VITE_HMR_PORT e VITE_HMR_PROTOCOL são injetados pelo docker-compose
# via .env da raiz — NÃO definir aqui para não sobrescrever os valores do compose

# Comando para iniciar em modo desenvolvimento
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
