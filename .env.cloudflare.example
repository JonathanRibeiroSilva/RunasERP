# ============================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ============================================

# Token gerado no Cloudflare Zero Trust Dashboard
# Para obter seu token:
# 1. Acesse: https://one.dash.cloudflare.com/
# 2. Navegue até: Access → Tunnels
# 3. Selecione seu tunnel
# 4. Copie o token ou use: cloudflared tunnel token <nome-do-tunnel>
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...","s":"XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...","t":"XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"}

# ============================================
# OAUTH CONFIGURATION (Override do .env principal)
# ============================================

# IMPORTANTE: Usar o domínio real após configurar o tunnel
# Se seu tunnel aponta para www.runaserp.com.br, use com www
# Se aponta para runaserp.com.br, use sem www
FRONTEND_URL=https://seu-dominio.com.br

# Google OAuth (copie do Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=sua-google-client-id.apps.googleusercontent.com

# Microsoft OAuth (copie do Azure Portal)
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
VITE_MICROSOFT_CLIENT_ID=sua-microsoft-client-id-uuid
VITE_MICROSOFT_TENANT_ID=common

# ============================================
# INSTRUÇÕES DE USO
# ============================================

# 1. Copie este arquivo para .env.cloudflare
#    cp .env.cloudflare.example .env.cloudflare

# 2. Configure seu Cloudflare Tunnel:
#    - Crie tunnel em: https://one.dash.cloudflare.com/
#    - Configure DNS para seu domínio
#    - Copie o token do tunnel

# 3. Atualize o FRONTEND_URL com seu domínio real

# 4. Configure OAuth redirect URLs:
#    - Google: https://seu-dominio.com.br/auth/google/callback
#    - Microsoft: https://seu-dominio.com.br/auth/microsoft/callback

# 5. NUNCA commite o arquivo .env.cloudflare (está no .gitignore)
