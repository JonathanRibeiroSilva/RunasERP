# ============================================
# CLOUDFLARE TUNNEL DE DEV (modo credencial)
# ============================================
# ATENCAO (verificado em 2026-09-28): NADA le o arquivo .env.cloudflare.
# docker-compose.cloudflare.yml nao tem env_file nem ${VAR}, o erp.ps1 so
# acrescenta "-f docker-compose.cloudflare.yml --profile proxy", e o compose so
# carrega sozinho o .env da raiz.
#
# Como o tunel de dev funciona de fato:
#   - cloudflared roda "tunnel --config /etc/cloudflared/config.yml run"
#     (docker-compose.cloudflare.yml:35), sem token.
#   - O tunel e a credencial vem de cloudflared-config.yml (tunnel + credentials-file)
#     e do diretorio ~/.cloudflared montado em /etc/cloudflared.
#   - O ingress serve so app.runaserp.com.br -> frontend-dev:3000; o Vite proxy
#     leva /api ao api-gateway. Apex e www ficam no Cloudflare Pages.
#   - FRONTEND_URL, API_BASE_URL e VITE_OAUTH_REDIRECT_URI ja estao fixos em
#     https://app.runaserp.com.br no docker-compose.cloudflare.yml.
#   - Os client IDs de OAuth vem do .env da raiz (ver .env.example).
# O modo token (CLOUDFLARE_TUNNEL_TOKEN) e o de producao: docker-compose.prod.yml,
# definido no Coolify (ver .env.production.example).

# As 5 variaveis abaixo EXISTEM no sistema, mas o valor posto AQUI nao tem efeito,
# porque nada carrega .env.cloudflare. Nao as remova do .env.example nem do
# .env.production.example: la elas sao lidas.

# SEM EFEITO NESTE ARQUIVO (verificado em 2026-09-28): candidata a remocao deste template.
# O tunel de dev nao usa token; so docker-compose.prod.yml le esta variavel.
CLOUDFLARE_TUNNEL_TOKEN=SEU_TOKEN

# SEM EFEITO NESTE ARQUIVO (verificado em 2026-09-28): candidata a remocao deste template.
# docker-compose.cloudflare.yml ja fixa FRONTEND_URL=https://app.runaserp.com.br.
FRONTEND_URL=https://app.runaserp.com.br

# SEM EFEITO NESTE ARQUIVO (verificado em 2026-09-28): candidata a remocao deste template.
# O frontend-dev recebe as tres do .env da raiz (e nenhum componente as usa hoje).
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=SEU_CLIENT_ID
VITE_MICROSOFT_TENANT_ID=common

# ============================================
# INSTRUÇÕES DE USO DO TUNEL DE DEV
# ============================================

# 1. Coloque o JSON de credencial do tunel em ~/.cloudflared
#    (o nome tem de bater com credentials-file em cloudflared-config.yml).

# 2. Suba com: .\erp.ps1 up -Cloudflare
#    ou: docker compose -f docker-compose.dev.yml -f docker-compose.cloudflare.yml --profile proxy up -d

# 3. Redirect URIs de OAuth: o frontend envia <origem>/auth/callback/<provedor>.
#    - Google: https://app.runaserp.com.br/auth/callback/google
#    - Microsoft: https://app.runaserp.com.br/auth/callback/microsoft

# 4. NUNCA commite um .env.cloudflare real (o .gitignore cobre .env.*).
